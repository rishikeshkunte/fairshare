rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }
    function email() {
      return request.auth.token.email.lower();
    }
    function isMember(data) {
      return signedIn()
        && data.memberEmails is list
        && email() in data.memberEmails;
    }

    match /groups/{groupId} {
      allow get: if isMember(resource.data);
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.memberEmails is list
        && email() in request.resource.data.memberEmails;
      allow update, delete: if isMember(resource.data);
    }

    match /direct_pairs/{pairId} {
      function inPair(data) {
        return signedIn()
          && data.participants is list
          && email() in data.participants;
      }
      allow read: if inPair(resource.data);
      allow create: if signedIn()
        && request.resource.data.participants is list
        && email() in request.resource.data.participants
        && request.resource.data.participants.size() == 2;
      allow update, delete: if inPair(resource.data)
        && email() in request.resource.data.participants;
    }

    match /friend_requests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.fromEmail == email()
        && request.resource.data.toEmail is string
        && request.resource.data.toEmail != email()
        && request.resource.data.status == "pending";
      allow read: if signedIn() && (
        resource.data.fromEmail == email() || resource.data.toEmail == email()
      );
      allow update: if signedIn() && (
        (
          resource.data.toEmail == email()
          && request.resource.data.status in ["accepted", "declined"]
          && request.resource.data.fromEmail == resource.data.fromEmail
          && request.resource.data.toEmail == resource.data.toEmail
        ) || (
          resource.data.fromEmail == email()
          && request.resource.data.fromEmail == resource.data.fromEmail
          && request.resource.data.toEmail == resource.data.toEmail
        )
      );
      allow delete: if signedIn() && resource.data.fromEmail == email();
    }
  }
}

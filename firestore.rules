rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }
    function email() {
      return request.auth.token.email.lower();
    }
    // Gmail ignores dots in the local part. Canonicalize Gmail addresses only;
    // other email providers keep their dots and local-part semantics.
    function canonical(e) {
      return e.matches('^[^@]+@gmail[.]com$')
        ? e.split('@')[0].replace('[.]', '') + '@gmail.com'
        : e;
    }
    function mine() {
      return canonical(email());
    }
    function isMember(data) {
      return signedIn()
        && data.memberEmails is list
        && email() in data.memberEmails;
    }
    function groupMember(groupId) {
      return signedIn()
        && email() in get(/databases/$(database)/documents/groups/$(groupId)).data.memberEmails;
    }
    function inviteRef(token) {
      return /databases/$(database)/documents/invites/$(token);
    }
    function inviteDoc(token) {
      return get(inviteRef(token)).data;
    }
    function validInvite(token, type) {
      return token is string
        && token.size() >= 16
        && exists(inviteRef(token))
        && inviteDoc(token).type == type
        && inviteDoc(token).revoked == false
        && inviteDoc(token).expiresAt > request.time;
    }
    function validGroupInvite(token, groupId) {
      return validInvite(token, "group")
        && inviteDoc(token).groupId == groupId;
    }
    function validFriendInvite(token, inviterEmail) {
      return validInvite(token, "friend")
        && inviteDoc(token).createdByEmail == inviterEmail;
    }

    // Membership documents can be discovered across groups by the signed-in
    // account. This is the Phase 5 discovery path; group access rules below still
    // validate the group document itself.
    match /{path=**}/members/{memberId} {
      allow list, get: if signedIn() && resource.data.emailCanonical == canonical(email());
    }

    // Each signed-in account owns its saved friends roster, independent of groups.
    match /user_profiles/{userId} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == userId;
    }

    match /groups/{groupId} {
      // A transaction may check whether a new group document exists before creating it.
      // Existing documents remain readable only by listed members.
      allow get: if signedIn()
        && (!exists(/databases/$(database)/documents/groups/$(groupId)) || isMember(resource.data));
      // Group discovery queries must constrain memberEmails to the signed-in email.
      // List rules evaluate membership directly because queried resource fields do
      // not reliably satisfy `is list` checks in the collection rule evaluation.
      allow list: if signedIn() && email() in resource.data.memberEmails;
      allow create: if signedIn()
        && request.resource.data.memberEmails is list
        && email() in request.resource.data.memberEmails;
      allow update: if isMember(resource.data);
      // A signed-in recipient of a valid, unexpired, unrevoked group invite may
      // add themselves. They cannot change the group's name, currency, ledger,
      // or remove existing members in this write.
      allow update: if signedIn()
        && request.resource.data.memberEmails is list
        && email() in request.resource.data.memberEmails
        && request.resource.data.lastJoinToken is string
        && validGroupInvite(request.resource.data.lastJoinToken, groupId)
        && resource.data.memberEmails is list
        && request.resource.data.memberEmails.hasAll(resource.data.memberEmails)
        && request.resource.data.memberEmails.size() <= resource.data.memberEmails.size() + 2
        && request.resource.data.members is list
        && resource.data.members is list
        && request.resource.data.members.hasAll(resource.data.members)
        && request.resource.data.members.size() <= resource.data.members.size() + 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'memberEmails', 'members', 'lastJoinToken', 'lastJoinAt', 'updatedAt', 'updatedBy'
           ]);
      allow delete: if isMember(resource.data);

      // Normalized group subcollections (migration phase). Membership still uses
      // the legacy memberEmails list until phase 3 switches the client to member
      // documents.
      match /members/{memberId} {
        allow read, write: if groupMember(groupId);
      }
      match /expenses/{expenseId} {
        allow read, write: if groupMember(groupId);
      }
      match /settlements/{settlementId} {
        allow read, write: if groupMember(groupId);
      }
    }

    match /direct_pairs/{pairId} {
      // Membership is derived from the signed-in token, never from a client-supplied
      // email alone. participantKeys are canonical for every writer; participants is
      // retained so existing documents with raw addresses remain readable.
      function pairMember(data) {
        return signedIn() && (
          (data.participantKeys is list && mine() in data.participantKeys)
          || (data.participants is list && (email() in data.participants || mine() in data.participants))
        );
      }
      function validPair(data) {
        return data.participants is list
          && data.participants.size() == 2
          && data.participantKeys is list
          && data.participantKeys.size() == 2
          && mine() in data.participantKeys
          && mine() in data.participants
          && data.participantKeys.hasAll(data.participants)
          && data.participants.hasAll(data.participantKeys);
      }
      function legacyPairKeys() {
        return [
          canonical(resource.data.participants[0]),
          canonical(resource.data.participants[1])
        ];
      }
      // Existing membership must survive every update. Legacy documents without keys
      // are compared using their canonicalized participants so migration is allowed
      // but adding or replacing a participant is still rejected.
      function stableMembership() {
        return resource.data.participants is list
          && resource.data.participants.size() == 2
          && request.resource.data.participantKeys is list
          && request.resource.data.participantKeys.size() == 2
          && (
            ('participantKeys' in resource.data)
              ? (
                resource.data.participantKeys is list
                && resource.data.participantKeys.size() == 2
                && resource.data.participantKeys.hasAll(request.resource.data.participantKeys)
                && request.resource.data.participantKeys.hasAll(resource.data.participantKeys)
              )
              : (
                request.resource.data.participantKeys.hasAll(legacyPairKeys())
                && legacyPairKeys().hasAll(request.resource.data.participantKeys)
              )
          );
      }
      // Permit checking a not-yet-created pair document before a transactional create.
      allow get: if signedIn()
        && (!exists(/databases/$(database)/documents/direct_pairs/$(pairId)) || pairMember(resource.data));
      // List authorization is evaluated against the canonical field used by the
      // participantKeys query; it remains derived from the authenticated token.
      allow list: if signedIn() && mine() in resource.data.participantKeys;
      allow create: if signedIn() && validPair(request.resource.data);
      allow update: if pairMember(resource.data) && validPair(request.resource.data) && stableMembership();
      allow delete: if pairMember(resource.data);
    }

    match /friend_requests/{requestId} {
      allow create: if signedIn() && (
        (
          request.resource.data.fromEmail == email()
          && request.resource.data.toEmail is string
          && request.resource.data.toEmail != email()
          && request.resource.data.status == "pending"
        ) || (
          // A recipient of a valid friend invite may create the accepted
          // connection directly. The invite proves the inviter's identity.
          request.resource.data.status == "accepted"
          && request.resource.data.toEmail == email()
          && request.resource.data.fromEmail is string
          && request.resource.data.fromEmail != email()
          && request.resource.data.inviteToken is string
          && validFriendInvite(request.resource.data.inviteToken, request.resource.data.fromEmail)
        )
      );
      allow read: if signedIn() && (
        resource.data.fromEmail == email() || resource.data.toEmail == email()
      );
      allow update: if signedIn() && (
        (
          resource.data.toEmail == email()
          && request.resource.data.status in ["accepted", "declined"]
          && request.resource.data.fromEmail == resource.data.fromEmail
          && request.resource.data.toEmail == resource.data.toEmail
        ) || (
          resource.data.fromEmail == email()
          && request.resource.data.fromEmail == resource.data.fromEmail
          && request.resource.data.toEmail == resource.data.toEmail
        )
      );
      allow delete: if signedIn() && resource.data.fromEmail == email();
    }

    // Token-based, multi-use, expiring, revocable invite links.
    match /invites/{token} {
      // The token is the secret. Any signed-in user who has it may read the
      // invite so the acceptance screen can show who invited them.
      allow get: if signedIn();
      allow list: if signedIn() && resource.data.createdByUid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.createdByEmail == email()
        && request.resource.data.revoked == false
        && request.resource.data.uses == 0
        && request.resource.data.type in ["group", "friend"]
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt < request.time + duration.value(7, 'd')
        && (
          request.resource.data.type == "friend"
          || (
            request.resource.data.type == "group"
            && request.resource.data.groupId is string
            && exists(/databases/$(database)/documents/groups/$(request.resource.data.groupId))
            && email() in get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.memberEmails
          )
        );
      allow update: if signedIn() && (
        // Creator can revoke at any time.
        (
          resource.data.createdByUid == request.auth.uid
          && request.resource.data.revoked == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revoked', 'revokedAt'])
        ) || (
          // Recipient can record a use while the invite is active.
          resource.data.revoked == false
          && resource.data.expiresAt > request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uses', 'lastUsedAt', 'lastUsedBy'])
          && request.resource.data.uses == resource.data.uses + 1
          && request.resource.data.lastUsedBy == email()
        )
      );
      allow delete: if signedIn() && resource.data.createdByUid == request.auth.uid;
    }
  }
}

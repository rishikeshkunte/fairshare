rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }
    function email() {
      return request.auth.token.email.lower();
    }
    // Gmail ignores dots. The app used to store only the dot-stripped form,
    // while these rules checked the real sign-in email, so dotted Gmail
    // accounts could not read or write their own ledgers.
    function canonical(e) {
      return e.matches('^[^@]+@gmail[.]com$')
        ? e.split('@')[0].replace('[.]', '') + '@gmail.com'
        : e;
    }
    function mine() {
      return canonical(email());
    }
    function isMember(data) {
      return signedIn()
        && data.memberEmails is list
        && (email() in data.memberEmails || mine() in data.memberEmails);
    }
    function pairMember(data) {
      return signedIn() && (
        (data.participantKeys is list && mine() in data.participantKeys)
        || (data.participants is list && (email() in data.participants || mine() in data.participants))
      );
    }

    match /groups/{groupId} {
      allow get: if isMember(resource.data);
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.memberEmails is list
        && (email() in request.resource.data.memberEmails || mine() in request.resource.data.memberEmails);
      allow update, delete: if isMember(resource.data);
    }

    match /direct_pairs/{pairId} {
      allow get: if pairMember(resource.data);
      allow list: if signedIn()
        && resource.data.participants is list
        && email() in resource.data.participants;
      allow create: if signedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && (email() in request.resource.data.participants || mine() in request.resource.data.participants)
        && (
          !('participantKeys' in request.resource.data)
          || (
            request.resource.data.participantKeys is list
            && request.resource.data.participantKeys.size() == 2
            && mine() in request.resource.data.participantKeys
          )
        );
      allow update: if pairMember(resource.data)
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && (email() in request.resource.data.participants || mine() in request.resource.data.participants)
        && (
          !('participantKeys' in request.resource.data)
          || (
            request.resource.data.participantKeys is list
            && request.resource.data.participantKeys.size() == 2
            && mine() in request.resource.data.participantKeys
          )
        );
      allow delete: if pairMember(resource.data);
    }

    match /friend_requests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.fromEmail == email()
        && request.resource.data.toEmail is string
        && request.resource.data.toEmail != email()
        && request.resource.data.status == "pending";
      allow read: if signedIn() && (
        resource.data.fromEmail == email() || resource.data.toEmail == email()
      );
      allow update: if signedIn() && (
        (
          resource.data.toEmail == email()
          && request.resource.data.status in ["accepted", "declined"]
          && request.resource.data.fromEmail == resource.data.fromEmail
          && request.resource.data.toEmail == resource.data.toEmail
        ) || (
          resource.data.fromEmail == email()
          && request.resource.data.fromEmail == resource.data.fromEmail
          && request.resource.data.toEmail == resource.data.toEmail
        )
      );
      allow delete: if signedIn() && resource.data.fromEmail == email();
    }

    match /user_profiles/{userId} {
      allow get, create, update, delete: if signedIn()
        && request.auth.uid == userId;
    }
  }
}

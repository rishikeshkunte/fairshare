{
  "routes": [
    { "src": "/", "dest": "/marketing.html" },
    { "src": "/index.html", "status": 307, "headers": { "Location": "/app/" } },
    { "src": "/app", "status": 307, "headers": { "Location": "/app/" } },
    { "src": "/app/", "dest": "/index.html" },
    { "src": "/app/(.*)", "dest": "/$1" },
    { "src": "/site/?", "status": 308, "headers": { "Location": "/" } },
    { "src": "/site/(.*)", "status": 308, "headers": { "Location": "/$1" } },
    { "handle": "filesystem" }
  ]
}
